%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 200 200
%%DocumentCustomColors: (CutContour)
%%CMYKCustomColor: 0 1 0 0 (CutContour)
%%EndComments
% Artwork: filled CMYK square
0 0.5 1 0 setcmykcolor
30 30 140 140 rectfill
% Cut line: spot colour stroke
[/Separation /CutContour /DeviceCMYK { dup 0 exch 0 0 } ] setcolorspace
1 setcolor
0.5 setlinewidth
20 20 moveto 180 20 lineto 180 180 lineto 20 180 lineto closepath stroke
showpage
%%EOF
