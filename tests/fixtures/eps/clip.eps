%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 200 200
%%EndComments
gsave
% Circular clip
newpath 100 100 60 0 360 arc closepath clip
newpath
1 0 0 0 setcmykcolor
0 0 200 100 rectfill
0 0 0.9 0 setcmykcolor
0 100 200 100 rectfill
grestore
0 0 0 1 setcmykcolor
1 setlinewidth
newpath 100 100 60 0 360 arc closepath stroke
showpage
%%EOF
