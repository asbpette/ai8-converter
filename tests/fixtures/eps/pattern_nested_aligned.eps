%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 128 128
%%Title: nested tiling patterns whose steps line up (inner 4 divides outer 32)
%%EndComments
% In PostScript the inner pattern is anchored in page space; because 32 is a
% multiple of 4, the result is also periodic with the outer tile, so the
% PDF/AI8 "pattern in pattern space" model reproduces it exactly.
<< /PatternType 1 /PaintType 1 /TilingType 1 /BBox [0 0 4 4] /XStep 4 /YStep 4
   /PaintProc { pop 0 0 0 1 setcmykcolor 0 0 2 2 rectfill } >> matrix makepattern /Inner exch def
<< /PatternType 1 /PaintType 1 /TilingType 1 /BBox [0 0 32 32] /XStep 32 /YStep 32
   /PaintProc { pop Inner setpattern 0 0 16 16 rectfill
                1 0 0 0 setcmykcolor 16 16 16 16 rectfill
                0 1 0 0 setcmykcolor newpath 8 24 6 0 360 arc closepath fill } >>
matrix makepattern /Outer exch def
Outer setpattern 0 0 128 128 rectfill
showpage
%%EOF
