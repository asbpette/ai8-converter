%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 200 200
%%Title: uncoloured tiling pattern (PaintType 2) with CMYK colours
%%EndComments
% Diagonal stripe (uncoloured: colour comes from setcolor).
<< /PatternType 1 /PaintType 2 /TilingType 1
   /BBox [0 0 10 10] /XStep 10 /YStep 10
   /PaintProc { pop 0 0 moveto 10 10 lineto 10 5 lineto 5 0 lineto closepath fill }
>> matrix makepattern /Stripe exch def
[/Pattern /DeviceCMYK] setcolorspace
0 1 0 0 Stripe setcolor
10 10 80 180 rectfill
1 0 0 0 Stripe setcolor
110 10 80 180 rectfill
0 1 0 0 Stripe setcolor
95 95 10 10 rectfill
showpage
%%EOF
